{
  "id": "bili",
  "name": "B站",
  "description": "按关键词搜视频、拉官方字幕——只读，不发评论、不点赞、不改任何东西",
  "version": "0.1.3",
  "api": "1.8",
  "app": "bili",
  "kind": "enricher",
  "entry": {
    "command": ["node", "src/main.mjs"]
  },
  "capabilities": ["provide.source"],
  "sources": [
    {
      "id": "bili.search_video",
      "title": "按关键词搜 B 站视频：标题 / UP / 播放量 / 时长 / 简介",
      "params": {
        "type": "object",
        "properties": {
          "q": { "type": "string", "description": "搜索关键词" },
          "page": { "type": "number", "description": "页码，从 1 开始；默认 1" },
          "order": {
            "type": "string",
            "description": "排序：totalrank(综合) / click(播放) / pubdate(最新) / dm(弹幕)；默认 totalrank",
            "default": "totalrank"
          }
        },
        "required": ["q"]
      }
    },
    {
      "id": "bili.video_subtitles",
      "title": "拉一条视频的官方字幕，按分钟切段返回（带 mm:ss 时间码）",
      "params": {
        "type": "object",
        "properties": {
          "bvid": { "type": "string", "description": "视频 BV 号，如 BV1xx411c7mD" },
          "from": { "type": "number", "description": "从第几分钟开始取；默认 0（从头）" },
          "lan": { "type": "string", "description": "字幕语言代码，默认 ai-zh（先找中文）" }
        },
        "required": ["bvid"]
      }
    }
  ],
  "config": {
    "schema": {
      "type": "object",
      "properties": {
        "sessdata": {
          "type": "string",
          "description": "B站登录 cookie 里的 SESSDATA。AI 字幕和部分搜索必须带登录态，没有就只能拿到公开结果"
        },
        "bili_jct": {
          "type": "string",
          "description": "cookie 里的 bili_jct（只读用途，不会发任何写请求）"
        },
        "buvid3": {
          "type": "string",
          "description": "cookie 里的 buvid3，缺了容易被风控拦"
        },
        "timeoutMs": {
          "type": "number",
          "description": "单次 HTTP 超时，默认 20000",
          "default": 20000
        },

        "rule1": { "type": "boolean", "description": "规则1（开关）" },
        "rule2": { "type": "boolean", "x-widget": "checkbox", "description": "规则2（勾选）" },
        "rule3": { "type": "string", "x-widget": "action", "description": "规则3（按钮）" },
        "rule4": { "type": "number", "minimum": 0, "maximum": 100, "x-step": 5, "description": "规则4（滑块）" },
        "rule5": {
          "type": "string",
          "enum": ["选项一", "选项二", "选项三", "选项四", "选项五"],
          "description": "规则5（五选一）"
        },
        "rule6": { "type": "string", "description": "规则6（输入框）" },
        "rule7": {
          "type": "string",
          "enum": ["下拉一", "下拉二", "下拉三", "下拉四", "下拉五", "下拉六"],
          "description": "规则7（下拉列表）"
        },
        "rule8": { "type": "string", "x-widget": "file", "description": "规则8（浏览文件）" },
        "rule9": { "type": "string", "x-widget": "textarea", "description": "规则9（多行输入）" },
        "rule10": {
          "type": "array",
          "description": "规则10（可增删改排序的列表，每项三个字段）",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "description": "名称" },
              "enabled": { "type": "boolean", "description": "启用" },
              "weight": { "type": "number", "description": "权重" }
            },
            "required": ["name"]
          }
        }
      }
    }
  },
  "ui": {
    "tabs": [
      {
        "id": "rules",
        "label": "规则",
        "kind": "config",
        "fields": [
          "rule1",
          "rule2",
          "rule3",
          "rule4",
          "rule5",
          "rule6",
          "rule7",
          "rule8",
          "rule9",
          "rule10"
        ]
      },
      {
        "id": "likes",
        "label": "点赞记录",
        "kind": "records",
        "records": { "type": "like", "limit": 50 }
      }
    ]
  },
  "author": "yuanling contributors",
  "license": "MIT"
}
